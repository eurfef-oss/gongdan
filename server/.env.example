PORT=8787
HOST=127.0.0.1
NODE_ENV=development
PRODUCT_ID=repair_pro_lifetime

# Only for local development. Keep false in production.
ALLOW_TEST_PURCHASES=true
STORE_DRIVER=mariadb

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=repair_license
DB_USER=repair_license
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

ANDROID_PACKAGE_NAME=com.cosdk.repairdesk
IOS_BUNDLE_ID=com.cosdk.repairdesk

# Google Play Developer API service account.
# Prefer GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64 so private-key newlines are preserved.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_PLAY_REQUEST_TIMEOUT_MS=10000
GOOGLE_PLAY_ACKNOWLEDGE_PURCHASES=true

# Ed25519 PKCS#8 private key, base64 encoded. Required for signed releases.
# Generate with: npm run generate-keys
ENTITLEMENT_PRIVATE_KEY_BASE64=
