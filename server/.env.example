PORT=8787
NODE_ENV=development
PRODUCT_ID=repair_pro_lifetime

# Only for local development. Keep false in production.
ALLOW_TEST_PURCHASES=true

# Run the server from the repository root, or set an absolute path.
DATA_FILE=server/data/license-store.json

ANDROID_PACKAGE_NAME=com.example.repairworkorderassistant
IOS_BUNDLE_ID=com.example.repairworkorderassistant

# Optional Ed25519 PKCS#8 private key, base64 encoded.
# Generate with: npm run generate-keys
ENTITLEMENT_PRIVATE_KEY_BASE64=
